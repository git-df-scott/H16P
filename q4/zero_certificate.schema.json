{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/git-df-scott/H16P/q4/zero_certificate.schema.json",
  "title": "Q4 interval Abelian-zero certificate",
  "type": "object",
  "required": ["format", "kappa", "mu", "root_boxes", "evaluator", "artifact_hashes"],
  "properties": {
    "format": {"const": "H16P-Q4-ZERO-v1"},
    "kappa": {"type": "object", "required": ["rational"], "properties": {"rational": {"type": "string"}}},
    "mu": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "object", "required": ["rational"], "properties": {"rational": {"type": "string"}}}
    },
    "root_boxes": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object",
        "required": ["s", "I_left", "I_right", "I_prime", "interval_newton_image"],
        "properties": {
          "s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "I_left": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "I_right": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "I_prime": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "interval_newton_image": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}
        }
      }
    },
    "endpoint_claim": {"enum": ["none", "excluded_with_expansions"]},
    "evaluator": {
      "type": "object", "required": ["library", "version", "precision_bits", "method"]
    },
    "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
